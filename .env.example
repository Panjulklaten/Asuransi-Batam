# Salin ke .env.local (lokal) dan isi di Vercel → Settings → Environment Variables.
# JANGAN commit nilai asli. File .env dan .env*.local sudah di-ignore oleh Git.

# Supabase (Project Settings → API). Hanya dipakai di server; JANGAN diberi awalan NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notifikasi WhatsApp via Fonnte (opsional; jika kosong, notifikasi WA dilewati)
FONNTE_TOKEN=
ADMIN_WA_NUMBER=

# Salt untuk hash IP (string acak panjang)
SPPA_IP_SALT=
