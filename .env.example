# Salin ke .env.local (lokal) dan isi di Vercel → Settings → Environment Variables.
# JANGAN commit nilai asli. File .env dan .env*.local sudah di-ignore oleh Git.

# Email lengkap ke admin via Resend (WAJIB; tanpa ini form membalas 503)
RESEND_API_KEY=
# Alamat tujuan; boleh beberapa dipisah koma. Tanpa domain terverifikasi di Resend,
# tujuan hanya boleh email pemilik akun Resend.
SPPA_NOTIFY_EMAIL=
# Opsional. Default: Asuransi Batam <onboarding@resend.dev>. Setelah domain diverifikasi di Resend,
# isi mis. "Asuransi Batam <sppa@asuransibatam.com>"
SPPA_EMAIL_FROM=

# Notifikasi WhatsApp ringkas via Fonnte (opsional; jika kosong, WA dilewati)
FONNTE_TOKEN=
ADMIN_WA_NUMBER=

# Salt untuk hash IP (string acak panjang)
SPPA_IP_SALT=


# ═════════════════════════════════════════════════════════════════════════════
# Mini Webmail (/mail) — lihat docs/webmail/README.md
# JANGAN commit nilai asli. Semua variabel ini HANYA dibaca di server.
# ═════════════════════════════════════════════════════════════════════════════

# RESEND_API_KEY (di atas) juga dipakai webmail. Webmail membaca email masuk lewat
# Receiving API, jadi gunakan API key dengan izin "Full access".

# Signing secret webhook (format whsec_...) dari Resend → Webhooks → webhook email.received
RESEND_WEBHOOK_SECRET=

# Supabase → Project Settings → API. Service role key bersifat RAHASIA (melewati RLS):
# hanya di environment server (Vercel), jangan pernah diberi awalan NEXT_PUBLIC_.
# SUPABASE_ANON_KEY sengaja TIDAK dipakai: browser tidak pernah berbicara ke database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Alamat pengirim & kotak surat utama (domain harus sudah terverifikasi di Resend)
MAIL_FROM_ADDRESS=info@asuransibatam.com
MAIL_FROM_NAME=Asuransi Batam

# Login admin webmail (satu akun; tidak ada registrasi publik).
# Buat hash dengan:  npm run mail:hash-password
MAIL_ADMIN_EMAIL=
MAIL_ADMIN_PASSWORD_HASH=
# String acak ≥ 32 karakter, mis. hasil:  openssl rand -base64 48
MAIL_SESSION_SECRET=
